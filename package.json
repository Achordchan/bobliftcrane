{
  "name": "bobliftcrane-wp-theme",
  "private": true,
  "version": "1.0.0",
  "description": "BOB-LIFT WordPress theme converted from the current Next.js front-end.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/input.css -o assets/css/theme.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/css/input.css -o assets/css/theme.css --watch",
    "start:wp": "PHP_CLI_SERVER_WORKERS=4 php -S 0.0.0.0:8080 -t .wordpress"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "gsap": "^3.15.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17"
  }
}
