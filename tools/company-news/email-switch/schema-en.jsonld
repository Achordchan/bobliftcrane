      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the email address for BOB-LIFT cranes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is info@boblift.com. The same address is used for cranes, mini skid steer loaders, mini dumpers and after-sales service across all BOB-LIFT websites."
          }
        },
        {
          "@type": "Question",
          "name": "I sent an enquiry to info@bobliftcrane.com. Will you see it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. That address still receives mail. For new messages and replies, please use info@boblift.com so that we can answer faster."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to do anything if I use the enquiry form?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The enquiry form on this website sends your message to info@boblift.com."
          }
        },
        {
          "@type": "Question",
          "name": "Is bobliftcrane.com still the website for BOB-LIFT cranes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Cranes stay on bobliftcrane.com. Loaders and dumpers are on bobliftloader.com, and boblift.com introduces the BOB-LIFT group as a whole."
